# Default SDK configuration for IoTEdgeConnect firmware.
# Override locally via sdkconfig; do not commit sdkconfig.

# Serial console
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# Task watchdog — panic on timeout so a stuck task produces a clean crash
# with a full backtrace rather than a silent warning loop.
CONFIG_ESP_TASK_WDT_PANIC=y

# Wi-Fi
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

# SNTP
CONFIG_LWIP_SNTP_MAX_SERVERS=1

# MQTT / TLS
# Enable the ESP-IDF MQTT component and mbedTLS for mTLS to AWS IoT Core.
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_ESP_TLS_SERVER_CERT_SELECT_HOOK=n
# Increase TLS handshake buffer to accommodate AWS IoT certificate chain.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
